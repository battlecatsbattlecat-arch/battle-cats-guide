{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://battlecatsbattlecat-arch.github.io/schemas/v2.3.12/build_manifest.schema.json",
  "type":"object",

  "$defs": {
    "sha": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "uuid": {"type":"string","pattern":"^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "build_id": {"type":"string","pattern":"^build-[0-9]{20,}-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "utc": {"type":"string","format":"date-time","pattern":"Z$"},
    "source": {"type":"object","additionalProperties":false,"required":["manifest_sha256","record_class","bootstrap_trust","snapshot_commit","step0_status","files"],"properties":{"manifest_sha256":{"$ref":"#/$defs/sha"},"record_class":{"enum":["provisional","formal"]},"bootstrap_trust":{"enum":["first_use","anchored"]},"snapshot_commit":{"type":["string","null"],"pattern":"^[0-9a-f]{40}$"},"step0_status":{"enum":["pending","formal"]},"files":{"type":"array","minItems":10,"maxItems":10,"items":{"type":"object","additionalProperties":false,"required":["path","byte_length","sha256","origin","rights_class"],"properties":{"path":{"type":"string","minLength":1},"byte_length":{"type":"integer","minimum":0},"sha256":{"$ref":"#/$defs/sha"},"origin":{"enum":["upstream","local_generated"]},"rights_class":{"enum":["code","upstream_curated_data","game_source_data","third_party_reference","local_generated_metadata","unknown"]}}}}}},
    "execution":{"type":"object","additionalProperties":false,"required":["scope","pipeline_revision","selected_ids"],"properties":{"scope":{"enum":["full","partial"]},"pipeline_revision":{"type":"string","minLength":1},"selected_ids":{"type":"array","uniqueItems":true,"items":{"type":"integer","minimum":0}}}},
    "common":{"type":"object","required":["schema_version","spec_version","record_class","publication_eligibility","build_disposition","build_state","build_id","build_sequence","created_at_utc","owner_uuid","source","execution"],"properties":{"schema_version":{"const":"1.0"},"spec_version":{"const":"2.3.12"},"record_class":{"enum":["provisional","formal"]},"publication_eligibility":{"type":"boolean"},"build_disposition":{"enum":["publishable","private_diagnostics"]},"build_state":{"enum":["candidate","complete"]},"build_id":{"$ref":"#/$defs/build_id"},"build_sequence":{"type":"integer","minimum":1},"created_at_utc":{"$ref":"#/$defs/utc"},"owner_uuid":{"$ref":"#/$defs/uuid"},"source":{"$ref":"#/$defs/source"},"execution":{"$ref":"#/$defs/execution"}}},
    "artifact":{"type":"object","additionalProperties":false,"required":["path","byte_length","sha256","kind"],"properties":{"path":{"type":"string","minLength":1},"byte_length":{"type":"integer","minimum":0},"sha256":{"$ref":"#/$defs/sha"},"kind":{"enum":["parsed","derived","anomalies","reports","registry_snapshot"]}}},
    "gate":{"type":"object","additionalProperties":false,"required":["gate_id","status","evidence_sha256"],"properties":{"gate_id":{"type":"string","minLength":1},"status":{"enum":["PASS","NOT_APPLICABLE"]},"evidence_sha256":{"$ref":"#/$defs/sha"}}},
    "candidate":{"allOf":[{"$ref":"#/$defs/common"},{"type":"object","properties":{"build_state":{"const":"candidate"}},"required":["build_state"]}],"type":"object","unevaluatedProperties":false},
    "complete":{"allOf":[{"$ref":"#/$defs/common"},{"type":"object","required":["completed_at_utc","configuration_inputs","artifacts","statistics","gate_results","test_results"],"properties":{"build_state":{"const":"complete"},"completed_at_utc":{"$ref":"#/$defs/utc"},"configuration_inputs":{"type":"array","minItems":3,"maxItems":3,"items":{"type":"object","additionalProperties":false,"required":["path","schema_version","byte_length","sha256"],"properties":{"path":{"enum":["config/field_registry.json","config/anomaly_rules.json","config/expected_anomalies.json"]},"schema_version":{"const":"1.0"},"byte_length":{"type":"integer","minimum":0},"sha256":{"$ref":"#/$defs/sha"}}}},"artifacts":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/artifact"}},"statistics":{"type":"object","additionalProperties":false,"required":["blocking_count","isolated_rows","unexpected_isolated_rows","files"],"properties":{"blocking_count":{"type":"integer","minimum":0},"isolated_rows":{"type":"integer","minimum":0},"unexpected_isolated_rows":{"type":"integer","minimum":0},"files":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["source_id","file_byte_length","bom_bytes","payload_bytes_total","eol_bytes_total","physical_lines","header_lines","blank_lines","normal_data_rows","isolated_rows","rejected_rows","lf_lines","crlf_lines","none_lines"],"properties":{"source_id":{"type":"string","minLength":1},"file_byte_length":{"type":"integer","minimum":0},"bom_bytes":{"enum":[0,3]},"payload_bytes_total":{"type":"integer","minimum":0},"eol_bytes_total":{"type":"integer","minimum":0},"physical_lines":{"type":"integer","minimum":0},"header_lines":{"type":"integer","minimum":0,"maximum":1},"blank_lines":{"type":"integer","minimum":0},"normal_data_rows":{"type":"integer","minimum":0},"isolated_rows":{"type":"integer","minimum":0},"rejected_rows":{"type":"integer","minimum":0},"lf_lines":{"type":"integer","minimum":0},"crlf_lines":{"type":"integer","minimum":0},"none_lines":{"type":"integer","minimum":0}}}}}},"gate_results":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/gate"}},"test_results":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/gate"}}}}],"type":"object","unevaluatedProperties":false}
  },
  "oneOf":[{"$ref":"#/$defs/candidate"},{"$ref":"#/$defs/complete"}]
}
